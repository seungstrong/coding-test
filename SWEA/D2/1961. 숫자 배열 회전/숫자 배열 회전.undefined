import java.util.Scanner;
import java.io.FileInputStream;

class Solution
{
	public static void main(String args[]) throws Exception
	{
		Scanner sc = new Scanner(System.in);
		int T;
		T=sc.nextInt();

		for(int test_case = 1; test_case <= T; test_case++)
		{
		
			/////////////////////////////////////////////////////////////////////////////////////////////
			int N = sc.nextInt();
            int arr[][] = new int[N][N];
            
            int rotate90[][] = new int[N][N];
            int rotate180[][] = new int[N][N];
            int rotate270[][] = new int[N][N];
            
            for(int i=0; i<N; i++){
            	for(int j=0; j<N; j++){
                    arr[i][j] = sc.nextInt();
                }
            }
            
            //1.90도
            for(int i=0; i<N; i++){
            	for(int j=0; j<N; j++){
                    rotate90[i][j] = arr[N-j-1][i];
                }
            }
            //2.180도
            for(int i=0; i<N; i++){
            	for(int j=0; j<N; j++){
                    rotate180[i][j] = arr[N-i-1][N-j-1];
                }
            }
            //3.270도
            for(int i=0; i<N; i++){
            	for(int j=0; j<N; j++){
                    rotate270[i][j] = arr[j][N-i-1];
                }
            }
                   // 0.0 0.1 0.2
                   // 1.0 1.1 1.2
                   // 2.0 2.1 2.2
                    
                   // 2.0 1.0 0.0
                   // 2.1 1.1 0.1
                   // 2.2 1.2 0.2
                    
                   // 2.2 2.1 2.0
                   // 1.2 1.1 1.0
                   // 0.2 0.1 0.0
            
                  // 0.2 1.2 2.2
                  // 0.1 1.1 2.1
                  // 0.0 1.0 2.0
            
            // 4. 결과
            System.out.println("#"+test_case);
            for(int i=0; i<N; i++){
                for(int j=0; j<N; j++){
                    System.out.print(rotate90[i][j]);
                }
                System.out.print(" ");
                for(int j=0; j<N; j++){
                    System.out.print(rotate180[i][j]);
                }
                System.out.print(" ");
                for(int j=0; j<N; j++){
                    System.out.print(rotate270[i][j]);
                }
                System.out.println();
            }
            
			/////////////////////////////////////////////////////////////////////////////////////////////

		}
	}
}